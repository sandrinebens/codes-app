<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Codes App - Search Engine"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter your search query"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@drawable/search_input_bg"
        android:layout_marginBottom="8dp" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/searchButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Search"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/favButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="Add to Favorites"
            android:background="@drawable/button_bg"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="Show History"
            android:background="@drawable/button_bg"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/favListButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Show Favorites"
            android:background="@drawable/button_bg"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/clearHistoryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Clear History"
            android:background="@drawable/button_bg" />

    </LinearLayout>

    <!-- WebView for search results -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- History ListView (Hidden by default) -->
    <ListView
        android:id="@+id/historyListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Favorites ListView (Hidden by default) -->
    <ListView
        android:id="@+id/favoritesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>